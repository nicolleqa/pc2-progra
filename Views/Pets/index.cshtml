@model pc2_progra.Models.Pets

@{
    ViewData["Title"] = "Registrar Nueva Mascota";
}

<div class="container">
    <h2>Registrar Nueva Mascota</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="control-label">Nombre de la Mascota</label>
                    <input asp-for="Nombre" class="form-control" required />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Edad" class="control-label">Edad</label>
                    <input asp-for="Edad" class="form-control" type="number" min="0" max="30" required />
                    <span asp-validation-for="Edad" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Tipo" class="control-label">Tipo de Mascota</label>
                    <select asp-for="Tipo" class="form-control" required>
                        <option value="">Seleccione un tipo</option>
                        <option value="Perro">Perro</option>
                        <option value="Gato">Gato</option>
                        <option value="Ave">Ave</option>
                        <option value="Otro">Otro</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Estado" class="control-label">Estado de Adopción</label>
                    <select asp-for="Estado" class="form-control" required>
                        <option value="Disponible">Disponible</option>
                        <option value="Adoptado">Adoptado</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Descripcion" class="control-label">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                      Registrar Mascota
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}