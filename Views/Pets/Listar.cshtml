@model IEnumerable<pc2_progra.Models.Pets>

@{
    ViewData["Title"] = "Lista de Mascotas";
}

<div class="container">
    <h2>Lista de Mascotas</h2>
    <p>
        <a asp-action="Index" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva Mascota
        </a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Edad</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Descripción</th>
                    <th>Fecha Registro</th>
                    <th>Adoptante</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Edad años</td>
                        <td>@item.Tipo</td>
                        <td>
                            @if (item.Estado == "Disponible")
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Adoptado</span>
                            }
                        </td>
                        <td>@item.Descripcion</td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.Adoption != null)
                            {
                                <span>@item.Adoption.Adopter.Nombre</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.table').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                },
                "order": [[5, "desc"]],
                "pageLength": 10
            });
        });
    </script>
}