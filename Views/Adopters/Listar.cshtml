@model IEnumerable<pc2_progra.Models.Adopters>

@{
    ViewData["Title"] = "Lista de Adoptantes";
}

<div class="container">
    <h2>Lista de Adoptantes</h2>
    <p>
        <a asp-action="Index" class="btn btn-primary">
           Nuevo Adoptante
        </a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th>Adopciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Email</td>
                        <td>@item.Telefono</td>
                        <td>@item.Direccion</td>
                        <td>
                            @(item.Adoptions?.Count ?? 0)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.table').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                }
            });
        });
    </script>
}